# PostgreSQL bağlantı adresi (Railway'de otomatik sağlanır: ${{ Postgres.DATABASE_URL }})
DATABASE_URL="postgresql://user:password@localhost:5432/teknonand?schema=public"

# JWT imzalama anahtarı — üretimde uzun/rastgele bir değerle değiştirin
JWT_SECRET="degistir-bu-cok-uzun-ve-rastgele-bir-deger-olmali"

# Panelin ilk kurulumunda oluşturulacak yönetici hesabı (bkz. src/scripts/seed-admin.js)
SEED_ADMIN_USERNAME="yonetici"
SEED_ADMIN_PASSWORD="teknonand"

# Frontend'in çalıştığı adres(ler) — virgülle ayırın (CORS için)
CORS_ORIGIN="http://localhost:5500"

# WhatsApp Business Cloud API (Meta) — Meta for Developers > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_LANG="tr"

# Meta Business Manager'da onaylanan her şablonun adı (bkz. src/services/whatsapp.js CLOUD_API_TEMPLATES)
WHATSAPP_TEMPLATE_RECEIVED=""
WHATSAPP_TEMPLATE_DIAGNOSIS_DONE=""
WHATSAPP_TEMPLATE_AWAITING_PARTS=""
WHATSAPP_TEMPLATE_READY=""
WHATSAPP_TEMPLATE_SHIPPED=""
WHATSAPP_TEMPLATE_DELIVERED=""

# Bayiye ait cihazlar için ayrı şablonlar — bayi adını içerir, bayi portalına
# yönlendirir; parça bekleniyor aşaması için bayiye bildirim gönderilmiyor
# (bkz. src/services/whatsapp.js DEALER_CLOUD_API_TEMPLATES). Meta Business
# Manager'daki (WhatsApp Yöneticisi > Mesaj şablonları) onaylı şablon adları:
WHATSAPP_TEMPLATE_DEALER_RECEIVED="cihaz_alindi_bayi"
WHATSAPP_TEMPLATE_DEALER_DIAGNOSIS_DONE="ariza_tespiti_tamamlandi_bayi"
WHATSAPP_TEMPLATE_DEALER_READY="teslime_hazir_bayi"
# kargoya_verildi_bayi ayrıca "Kargomu Takip Et" adlı dinamik URL düğmesi içerir
# (Yurtiçi Kargo gönderi sorgulama sayfasına takip no ile yönlendirir).
WHATSAPP_TEMPLATE_DEALER_SHIPPED="kargoya_verildi_bayi"
WHATSAPP_TEMPLATE_DEALER_DELIVERED="teslim_edildi_bayi"

# Bayiler sayfasındaki "WhatsApp ile Bakiye Bildir" butonu (bkz.
# src/services/whatsapp.js sendDealerBalanceReminder, src/routes/dealers.js
# POST /:id/balance-whatsapp) — güncel veresiye bakiyesini otomatik gönderir.
WHATSAPP_TEMPLATE_DEALER_BALANCE="bayi_bakiye_bildirimi"

# Bayi detayındaki "Portal Bildirimini WhatsApp ile Gönder" butonu (bkz.
# src/services/whatsapp.js sendDealerPortalNotice, src/routes/dealers.js
# POST /:id/portal-notice-whatsapp) — bayiye hesabının aktif olduğunu ve bayi
# portalı linkini otomatik gönderir. Meta'nın kullanıcı adı/şifre içeren şablonları
# "Kimlik Doğrulama" sayıp reddetmesi nedeniyle bu şablon giriş bilgilerini içermez —
# kullanıcı adı ve şifre personel tarafından ayrıca iletilir. Şablonu Meta'da bir
# kereliğine oluşturmak için bkz. src/routes/settings.js POST
# /whatsapp-templates/create-dealer-portal-notice-template.
WHATSAPP_TEMPLATE_DEALER_PORTAL_NOTICE="bayi_giris_bilgileri"

# Cihazlar sayfasındaki "⭐ Google Yorum İste" butonu (bkz. src/services/whatsapp.js
# sendGoogleReviewRequest, src/routes/devices.js POST /:id/google-review-whatsapp) —
# müşteriye Google İşletme Profili değerlendirme linkini otomatik gönderir.
WHATSAPP_TEMPLATE_GOOGLE_REVIEW=""

# Belge (PDF) gönderimi için header bileşenli şablonlar (bkz. src/routes/devices.js)
WHATSAPP_TEMPLATE_INVOICE=""
WHATSAPP_TEMPLATE_DELIVERY_FORM=""

# Toptancı sayfasındaki "Bu Toptancıdan Alınan Stok Kalemleri" tarih aralığı PDF'i
# (bkz. src/routes/suppliers.js POST /:id/stock-pdf-whatsapp) — toptancının kendi
# numarasına veya aşağıdaki sabit ofis/muhasebe hattına belge olarak gönderir.
WHATSAPP_TEMPLATE_SUPPLIER_STOCK="toptanci_stok_dokumu"
SUPPLIER_STOCK_PDF_EXTRA_PHONE=""

# Müşterilerin numaramıza yazdığı mesajları panelde göstermek için (bkz. src/routes/whatsappInbox.js)
# — Meta for Developers > WhatsApp > Configuration > Webhook alanına aynı değeri girin.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# Meta App Secret — webhook isteklerinin gerçekten Meta'dan geldiğini doğrulamak için
# (bkz. src/middleware/verifyMetaSignature.js). Meta for Developers > [Uygulaman] >
# App Settings > Basic > "App Secret" alanından alınır. Boş bırakılırsa doğrulama
# atlanır (geriye dönük uyumluluk) — mutlaka doldurulması önerilir.
WHATSAPP_APP_SECRET=""
INSTAGRAM_APP_SECRET=""

# Web sitesinden yeni randevu talebi geldiğinde işletmeye WhatsApp'tan haber verir
# (bkz. src/services/whatsapp.js sendNewAppointmentStaffAlert) ve panelden müşteriye
# gönderilen randevu onayı için (sendAppointmentConfirmation) — ikisi de Meta'da
# onaylı birer şablon gerektirir.
WHATSAPP_STAFF_ALERT_PHONE=""
WHATSAPP_TEMPLATE_NEW_APPOINTMENT=""
WHATSAPP_TEMPLATE_APPOINTMENT_CONFIRMED=""

# Yeni randevu talebi geldiğinde e-posta bildirimi (Gmail SMTP)
# GMAIL_APP_PASSWORD: Google Hesabı → Güvenlik → Uygulama Şifreleri üzerinden alınır (2FA açık olmalı)
GMAIL_USER="teknonand@gmail.com"
GMAIL_APP_PASSWORD=""
NOTIFY_EMAIL="teknonand@gmail.com"

PORT=3000

# Günlük Postgres yedekleme (src/scripts/backup-db.js) — ayrı bir Railway cron
# servisinde çalışır. BUCKET/ENDPOINT/REGION/ACCESS_KEY_ID/SECRET_ACCESS_KEY
# Railway Storage Bucket'ının değişken referanslarıdır (elle girilmez).
BUCKET=""
ENDPOINT=""
REGION="auto"
ACCESS_KEY_ID=""
SECRET_ACCESS_KEY=""
BACKUP_RETENTION_DAYS=30

# Ödeal E-FaturaPos entegrasyonu — Nakit / Banka Hesabı (Havale-EFT) ödemelerinde
# faturanın cihazdan otomatik kesilmesi için (bkz. src/services/odeal.js,
# src/routes/odealWebhook.js). Kredi Kartı hariç (kart cihazdan geçtiğinde Ödeal
# zaten kendiliğinden fatura kesiyor) ve Sanal POS hariç (Ödeal'in ayrı/bağımsız
# bir ürünü, bu API'nin kapsamında değil).
# ODEAL_MERCHANT_KEY / ODEAL_SECRET_KEY: portal.odeal.com/giris > Ayarlar >
# Entegrasyon Bilgileri'nden alınır (header: X-ODEAL-MERCHANT-KEY / X-ODEAL-SECRET-KEY).
# ODEAL_DEVICE_KEY: Cihazın Ödeal Stage uygulaması > Cihazlarım menüsünden tanımlanan cihaz kodu (externalDeviceKey).
# ODEAL_API_BASE_URL: prod varsayılan; test için https://stage.odealapp.com/api/v1 verilebilir.
ODEAL_MERCHANT_KEY=""
ODEAL_SECRET_KEY=""
ODEAL_DEVICE_KEY=""
ODEAL_API_BASE_URL="https://api.odeal.com/api/v1"
# Ödeal panelinde webhooks/odeal callback URL'ine ?token= parametresiyle ekleyeceğiniz
# rastgele bir değer — Ödeal kendi imza şemasını belgeleyene kadar geçici koruma
# (bkz. src/routes/odealWebhook.js).
ODEAL_WEBHOOK_TOKEN=""
