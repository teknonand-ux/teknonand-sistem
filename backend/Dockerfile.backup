# Postgres sunucusuyla (18) aynı imajdan başlanır, böylece pg_dump sürümü
# her zaman sunucuyla birebir eşleşir — ayrı bir apt deposu eklemeye gerek kalmaz.
FROM postgres:18-alpine

RUN apk add --no-cache nodejs npm

WORKDIR /app
# Yalnızca yükleme scripti için gereken tek bağımlılık kurulur; paylaşılan
# package.json'daki Prisma vb. bağımlılıklar (ve postinstall adımları) bu
# imaja dahil edilmez.
RUN npm install --no-save @aws-sdk/client-s3@3.700.0
COPY src/scripts/backup-db.js ./src/scripts/backup-db.js

CMD ["node", "src/scripts/backup-db.js"]
