// Teknonand Yönetim Sistemi — Veritabanı Şeması
// sistem-plani.md ile prototip HTML ekranlarının (bayi-portali, randevu-al,
// takip-portali, yonetici-paneli) ihtiyaçları birleştirilerek oluşturulmuştur.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Kimlik doğrulama
// ---------------------------------------------------------------------------

enum EmployeePermission {
  ADMIN // Yönetici — tüm sayfalar (Kasa, Kâr/Zarar, Etiket/Belge Tasarımı dahil)
  RESTRICTED // Kısıtlı — admin-only sayfalar gizli
}

model Employee {
  id           String             @id @default(uuid())
  name         String
  role         String // serbest metin: Teknisyen / Kasiyer / Yönetici vb.
  username     String             @unique
  passwordHash String
  permission   EmployeePermission @default(RESTRICTED)
  phone        String?
  email        String?
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())

  // 3 hatalı giriş denemesinde hesap kilitlenir (bkz. routes/auth.js) — sadece
  // yönetici (routes/employees.js POST /:id/unlock) kilidi açabilir, otomatik
  // süre sonunda açılmaz (kasıtlı: hedefli saldırı denemesini yönetici görsün).
  failedLoginAttempts Int         @default(0)
  lockedAt            DateTime?

  assignedDevices Device[]             @relation("AssignedEmployee")
  statusChanges   DeviceStatusHistory[]
  addedDeviceParts DevicePart[]
  repairs         Repair[]
  whatsappChatMessages WhatsappChatMessage[]
  instagramChatMessages InstagramChatMessage[]
  labelPrintJobs  LabelPrintJob[]
  cashboxResets   CashboxReset[]

  @@map("employees")
}

model Dealer {
  id           String   @id @default(uuid())
  name         String
  phone        String?
  username     String   @unique
  passwordHash String
  balance      Decimal  @default(0) @db.Decimal(12, 2) // pozitif = bayi borçlu (veresiye)
  createdAt    DateTime @default(now())

  devices      Device[]
  transactions DealerTransaction[]

  @@map("dealers")
}

enum DealerTxType {
  VERESIYE_SATIS
  TAHSILAT
}

model DealerTransaction {
  id          String       @id @default(uuid())
  dealerId    String
  dealer      Dealer       @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  deviceId    String? // otomatik olusturulan "teslim edildi" veresiye kayitlari icin
  device      Device?      @relation(fields: [deviceId], references: [id])
  type        DealerTxType
  amount      Decimal      @db.Decimal(12, 2)
  description String?
  createdAt   DateTime     @default(now())

  @@map("dealer_transactions")
}

// ---------------------------------------------------------------------------
// Müşteri / Cihaz
// ---------------------------------------------------------------------------

model Customer {
  id          String   @id @default(uuid())
  fullName    String
  phone       String
  backupPhone String?
  email       String?
  createdAt   DateTime @default(now())

  devices Device[]
  whatsappConversations WhatsappConversation[]
  instagramConversations InstagramConversation[]

  @@index([phone])
  @@map("customers")
}

enum DeviceStatus {
  RECEIVED // alındı
  DIAGNOSING // inceleniyor
  DIAGNOSIS_DONE // arıza tespiti bitti — müşteri/bayi onayı bekleniyor
  AWAITING_PARTS // parça bekliyor
  APPROVED // fiyat onaylandı — onarılıyor
  IN_REPAIR // tamir ediliyor
  TESTING // test ediliyor
  READY // teslime hazır
  SHIPPED // kargoya verildi (Yurtiçi Kargo takip numarasıyla)
  DELIVERED // teslim edildi
  RETURN_REQUESTED // müşteri/bayi iade istedi — henüz fiilen iade edilmedi
  RETURNED // iade edildi
  CANCELLED // iptal
}

model Device {
  id               String   @id @default(uuid())
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id])
  dealerId         String?
  dealer           Dealer?  @relation(fields: [dealerId], references: [id])
  assignedEmployeeId String?
  assignedEmployee Employee? @relation("AssignedEmployee", fields: [assignedEmployeeId], references: [id])

  trackingCode String @unique // örn. TKN-2026-0342
  brand        String @default("Apple")
  model        String
  imeiSerial   String?
  devicePassword String? // cihaz ekran kilidi / şifresi
  backupPhone    String? // bu kayıt için ek iletişim telefonu
  deviceOff      Boolean @default(false) // cihaz kapalı / IMEI okunamadı
  isCargo        Boolean @default(false) // cihaz kargo ile mi teslim alındı
  cargoAddress   String? // kargo gönderen adresi (opsiyonel)
  intakeImages   Json    @default("[]") // cihaz alındı aşamasında eklenen görseller (opsiyonel, en fazla 4)

  issueDescription String
  status           DeviceStatus @default(RECEIVED)

  diagnosingImages Json    @default("[]") // İnceleniyor aşamasında eklenen görseller (opsiyonel, en fazla 4)

  diagnosisText   String?
  estimatedPrice  Decimal? @db.Decimal(12, 2)
  diagnosisImages Json     @default("[]") // base64 dataURL dizisi (en fazla 4)
  customerApproved Boolean @default(false)
  dealerApproved   Boolean @default(false)
  approvalNote     String?
  approvedAt       DateTime?

  returnReason  String?
  returnImages  Json    @default("[]")

  readyImages   Json    @default("[]") // Teslime Hazır aşamasında eklenen görseller (opsiyonel, en fazla 4)

  deliveryMethod String?
  deliveryNote   String?
  deliveryImages Json    @default("[]")
  cargoTrackingNumber String? // durum SHIPPED'e (kargoya verildi) geçerken girilen Yurtiçi Kargo takip numarası

  invoicePdf       String?   // fatura, base64 data URL (data:application/pdf;base64,...)
  invoiceUploadedAt DateTime?

  // Musteri/bayi kendi panelinden ariza tespitini onaylayip/reddettiginde veya iade
  // istediginde false olur (bkz. track.js, dealers.js); yonetici panelde cihaz
  // acildiginda tekrar true olur. Yonetici paneli "Cihazlar" basliginin yanindaki
  // bildirim rozetinde false olan kayit sayisi gosterilir.
  approvalSeenByStaff Boolean @default(true)

  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  statusHistory DeviceStatusHistory[]
  parts         DevicePart[]
  payments      Payment[]
  stockMovements StockMovement[]
  repair        Repair?
  whatsappMessages WhatsappMessage[]
  dealerTransactions DealerTransaction[]
  diagnosisItems DiagnosisItem[]

  @@index([status])
  @@index([customerId])
  @@index([dealerId])
  @@map("devices")
}

model DeviceStatusHistory {
  id             String       @id @default(uuid())
  deviceId       String
  device         Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  status         DeviceStatus
  note           String?
  changedByEmployeeId String?
  changedByEmployee   Employee? @relation(fields: [changedByEmployeeId], references: [id])
  changedAt      DateTime     @default(now())

  @@map("device_status_history")
}

// Bir cihazda birden fazla ariza olabilir -- her biri ayri satir, ayri fiyat ve
// ayri musteri/bayi onayi (approved: null = beklemede, true = onaylandi, false = reddedildi/yapilmasin)
model DiagnosisItem {
  id          String    @id @default(uuid())
  deviceId    String
  device      Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  description String
  price       Decimal   @db.Decimal(12, 2)
  approved    Boolean?
  respondedBy String? // "customer" | "dealer"
  respondedAt DateTime?
  respondNote String? // müşteri/bayi kararıyla birlikte bıraktığı kısa not (opsiyonel)
  createdAt   DateTime  @default(now())

  @@map("diagnosis_items")
}

// ---------------------------------------------------------------------------
// Tamir / Parça / Ödeme
// ---------------------------------------------------------------------------

model Repair {
  id            String    @id @default(uuid())
  deviceId      String    @unique
  device        Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  technicianId  String?
  technician    Employee? @relation(fields: [technicianId], references: [id])
  laborCost     Decimal   @default(0) @db.Decimal(12, 2)
  startedAt     DateTime?
  completedAt   DateTime?

  @@map("repairs")
}

enum VatMode {
  DAHIL // fiyata KDV dahil
  HARIC // fiyata %20 KDV eklenir
}

model DevicePart {
  id             String   @id @default(uuid())
  deviceId       String
  device         Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  stockItemId    String?
  stockItem      StockItem? @relation(fields: [stockItemId], references: [id])
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id])
  addedByEmployeeId String? // ekleyen personel -- sadece yonetici panelinde gosterilir, musteri/bayi portallarina hic gonderilmez
  addedByEmployee   Employee? @relation(fields: [addedByEmployeeId], references: [id])
  name           String
  price          Decimal  @db.Decimal(12, 2) // satış fiyatı
  cost           Decimal  @default(0) @db.Decimal(12, 2) // maliyet (kâr/zarar hesaplamasında kullanılır)
  costUsd        Decimal? @db.Decimal(12, 2)
  vatMode        VatMode  @default(DAHIL)
  warrantyMonths Int      @default(0) // 0 = garanti yok
  createdAt      DateTime @default(now())

  @@map("device_parts")
}

enum PaymentType {
  KAPORA
  ARA_ODEME
  FINAL
}

model Payment {
  id       String        @id @default(uuid())
  deviceId String
  device   Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  amount   Decimal       @db.Decimal(12, 2)
  method   String // Nakit / Banka Hesabı / Kredi Kartı / Sanal POS
  type     PaymentType   @default(ARA_ODEME)
  paidAt   DateTime      @default(now())
  createdAt DateTime     @default(now())

  @@map("payments")
}

// ---------------------------------------------------------------------------
// Stok / Toptancı
// ---------------------------------------------------------------------------

model StockItem {
  id           String   @id @default(uuid())
  name         String
  sku          String?
  category     String?
  quantity     Int      @default(0)
  minThreshold Int      @default(0)
  unitCostTry  Decimal  @db.Decimal(12, 2)
  unitCostUsd  Decimal? @db.Decimal(12, 2)
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id])
  createdAt    DateTime @default(now())

  movements  StockMovement[]
  usedInParts DevicePart[]
  supplierTransactions SupplierTransaction[]

  @@map("stock_items")
}

enum StockMoveReason {
  KULLANIM
  ALIM
  IADE
}

model StockMovement {
  id             String          @id @default(uuid())
  stockItemId    String
  stockItem      StockItem       @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  deviceId       String?
  device         Device?         @relation(fields: [deviceId], references: [id])
  quantityChange Int // pozitif = giriş, negatif = çıkış
  reason         StockMoveReason
  createdAt      DateTime        @default(now())

  @@map("stock_movements")
}

model Supplier {
  id                String   @id @default(uuid())
  name              String
  phone             String?
  contactPerson     String?
  currentBalance    Decimal  @default(0) @db.Decimal(12, 2)
  currentBalanceUsd Decimal  @default(0) @db.Decimal(12, 2)
  createdAt         DateTime @default(now())

  transactions SupplierTransaction[]
  stockItems   StockItem[]
  deviceParts  DevicePart[]
  expenses     Expense[]

  @@map("suppliers")
}

enum SupplierTxType {
  ALIM
  ODEME
}

enum SupplierTxCurrency {
  TRY
  USD
}

model SupplierTransaction {
  id          String              @id @default(uuid())
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  stockItemId String? // stok kaleminden otomatik olusan borc kaydi icin -- kalem silinirse geri alinabilmesi icin
  stockItem   StockItem?          @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  type        SupplierTxType
  currency    SupplierTxCurrency  @default(TRY)
  amount      Decimal             @db.Decimal(12, 2)
  description String?
  createdAt   DateTime            @default(now())

  @@map("supplier_transactions")
}

// ---------------------------------------------------------------------------
// Kasa
// ---------------------------------------------------------------------------

model Expense {
  id          String   @id @default(uuid())
  category    String // Toptancı Ödemesi / Kira / Fatura / Personel Maaşı / Diğer
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  amount      Decimal  @db.Decimal(12, 2)
  method      String // Nakit / Banka Hesabı / Kredi Kartı / Sanal POS
  description String?
  createdAt   DateTime @default(now())

  @@map("expenses")
}

// Kasa sıfırlama: yönetici "Kasayı Sıfırla" dediğinde kapanan dönemin
// (bir önceki sıfırlamadan bu ana kadar) gelir/gider/net özeti burada
// arşivlenir. Ödeme/gider kayıtları silinmez — Kasa ekranı bir sonraki
// sıfırlamaya kadar yalnızca bu tarihten sonrasını gösterir.
model CashboxReset {
  id           String    @id @default(uuid())
  periodStart  DateTime
  periodEnd    DateTime  @default(now())
  totalIncome  Decimal   @db.Decimal(12, 2)
  totalExpense Decimal   @db.Decimal(12, 2)
  net          Decimal   @db.Decimal(12, 2)
  note         String?
  employeeId   String?
  employee     Employee? @relation(fields: [employeeId], references: [id])
  createdAt    DateTime  @default(now())

  @@map("cashbox_resets")
}

// ---------------------------------------------------------------------------
// Randevu
// ---------------------------------------------------------------------------

enum AppointmentSource {
  WEBSITE
  PANEL
}

model Appointment {
  id           String            @id @default(uuid())
  customerName String
  phone        String
  datetime     DateTime
  service      String?
  source       AppointmentSource @default(PANEL)
  createdAt    DateTime          @default(now())

  @@map("appointments")
}

// ---------------------------------------------------------------------------
// WhatsApp
// ---------------------------------------------------------------------------

enum WhatsappStatus {
  GONDERILDI
  OKUNDU
  BASARISIZ
}

model WhatsappMessage {
  id           String         @id @default(uuid())
  deviceId     String?
  device       Device?        @relation(fields: [deviceId], references: [id])
  customerId   String?
  templateType String // "cihaz_alindi" / "parca_bekleniyor" / "teslime_hazir" vb.
  content      String
  status       WhatsappStatus @default(GONDERILDI)
  errorMessage String?
  sentAt       DateTime       @default(now())

  @@map("whatsapp_messages")
}

// Müşterinin yeni WhatsApp numaramıza serbest metin olarak yazdığı, panelde
// gelen kutusu gibi görüntülenip yanıtlanan sohbetler — statü bildirimi
// şablonlarından (WhatsappMessage) bağımsız, ayrı bir akış.
enum WhatsappDirection {
  IN // müşteriden bize
  OUT // bizden müşteriye
}

model WhatsappConversation {
  id                 String    @id @default(uuid())
  phone              String    @unique // wa_id — 90XXXXXXXXXX formatında
  customerId         String?
  customer           Customer? @relation(fields: [customerId], references: [id])
  contactName        String? // Meta'nın gönderdiği WhatsApp profil adı (varsa)
  lastMessageAt      DateTime  @default(now())
  lastMessagePreview String?
  unreadCount        Int       @default(0)
  createdAt          DateTime  @default(now())

  messages WhatsappChatMessage[]

  @@map("whatsapp_conversations")
}

model WhatsappChatMessage {
  id             String               @id @default(uuid())
  conversationId String
  conversation   WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      WhatsappDirection
  body           String
  waMessageId    String?              @unique // Meta mesaj id'si — webhook tekrarlarını (retry) ayıklamak için
  mediaUrl       String? // musteriden gelen gorsel/belge (dekont vb.) — base64 data URL
  mediaMimeType  String?
  mediaFilename  String?
  employeeId     String? // OUT mesajını panelden gönderen personel
  employee       Employee?            @relation(fields: [employeeId], references: [id])
  createdAt      DateTime             @default(now())

  @@index([conversationId])
  @@map("whatsapp_chat_messages")
}

model InstagramConversation {
  id                 String    @id @default(uuid())
  igsid              String    @unique // Instagram-scoped kullanıcı id'si (gönderen/alıcı)
  customerId         String?
  customer           Customer? @relation(fields: [customerId], references: [id])
  username           String? // biliniyorsa Instagram kullanıcı adı (@handle)
  lastMessageAt      DateTime  @default(now())
  lastMessagePreview String?
  unreadCount        Int       @default(0)
  createdAt          DateTime  @default(now())

  messages InstagramChatMessage[]

  @@map("instagram_conversations")
}

model InstagramChatMessage {
  id             String                 @id @default(uuid())
  conversationId String
  conversation   InstagramConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      WhatsappDirection
  body           String
  igMessageId    String?                @unique // Meta mesaj id'si — webhook tekrarlarını (retry) ayıklamak için
  employeeId     String? // OUT mesajını panelden gönderen personel
  employee       Employee?              @relation(fields: [employeeId], references: [id])
  createdAt      DateTime               @default(now())

  @@index([conversationId])
  @@map("instagram_chat_messages")
}

// ---------------------------------------------------------------------------
// Ayarlar (döviz kuru, etiket tasarımı, firma bilgileri) — key/value
// ---------------------------------------------------------------------------

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// ---------------------------------------------------------------------------
// Uzaktan etiket yazdırma kuyruğu — personel mobil/kendi bilgisayarından
// "Etiketi Yazdır"a basınca istek burada kuyruğa girer; "ana yazıcı" olarak
// işaretlenmiş bilgisayardaki panel bu kuyruğu yoklayıp otomatik yazdırır.
// ---------------------------------------------------------------------------

enum LabelPrintJobStatus {
  PENDING
  PRINTED
}

model LabelPrintJob {
  id                    String              @id @default(uuid())
  trackingCode          String
  customerName          String
  customerPhone         String?
  issueDescription      String?
  devicePassword        String?
  imeiSerial            String?
  status                LabelPrintJobStatus @default(PENDING)
  requestedByEmployeeId String?
  requestedByEmployee   Employee?           @relation(fields: [requestedByEmployeeId], references: [id])
  createdAt             DateTime            @default(now())
  printedAt             DateTime?

  @@map("label_print_jobs")
}
